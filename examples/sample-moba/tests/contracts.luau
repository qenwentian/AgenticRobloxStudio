local Combat = require("../src/server/CombatService")
local Abilities = require("../src/server/AbilityService")
local Inventory = require("../src/server/InventoryService")
local Match = require("../src/server/MatchService")
local Hud = require("../src/client/Hud")
assert(Combat.ApplyDamage({ BaseDamage = 100, Armor = 100 }).FinalDamage == 50)
assert(Abilities.Cast(Combat.ApplyDamage, 100, 100).FinalDamage == 50)
assert(not pcall(Combat.ApplyDamage, { BaseDamage = -1, Armor = 10 }))
assert(Inventory.TotalPower({ 3, 4, 5 }) == 12)
assert(Match.CanStart(10) and not Match.CanStart(9))
assert(Hud.HealthFraction(50, 100) == 0.5)
assert(Hud.HealthFraction(150, 100) == 1)
print("MOBA interface and behavior checks passed")
