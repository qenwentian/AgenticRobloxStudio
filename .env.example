# Copy to .env for Docker Compose. For local Python, export these in the process environment.
# Choose high-entropy values. Do not commit your .env or .studiosync.json.
STUDIOSYNC_BOOTSTRAP_KEY=replace-with-a-random-administrator-key
STUDIOSYNC_POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
STUDIOSYNC_DATABASE_URL=sqlite:///./studiosync.db
STUDIOSYNC_SESSION_TTL=90
STUDIOSYNC_EVENT_RETENTION_DAYS=90
# Set per developer after login; tokens expire in eight hours.
STUDIOSYNC_TOKEN=
STUDIOSYNC_CONFIG=.studiosync.json
